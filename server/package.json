{
  "name": "@malaysian-tax/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Malaysian tax computation — ITA 1967, RPGTA 1976, Stamp Act 1949",
  "type": "module",
  "bin": {
    "malaysian-tax-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "content"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && node scripts/copy-content.js"
  },
  "keywords": [
    "mcp",
    "malaysian-tax",
    "tax-computation",
    "lhdn",
    "ita-1967",
    "rpgta-1976",
    "stamp-act-1949"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
